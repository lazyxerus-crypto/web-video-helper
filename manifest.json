{
  "manifest_version": 3,
  "name": "웹 영상 도우미: 배속 · 전체화면 · 연속재생",
  "version": "6.1.2",
  "description": "이어보기 · ani.ohli24.com 회차 규칙 · 5초 뒤로·85초 스킵·이전/다음 화 · 배속 · 소리 있는 자동재생만 시도",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "웹 영상 도우미 열기/닫기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
